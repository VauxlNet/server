FROM rust:slim-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY .sqlx/ ./.sqlx/
COPY migrations/ ./migrations/

ENV SQLX_OFFLINE=true
RUN cargo build --locked --release -p vauxl-server

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/target/release/vauxl-server ./vauxl-server
COPY config/ ./config/
COPY docker/complement-entrypoint.sh ./complement-entrypoint.sh

EXPOSE 8008
EXPOSE 8448
ENTRYPOINT ["/bin/sh", "/app/complement-entrypoint.sh"]
